all:
  vars:
    proxmox_host_tailscale_ip: <tailscale-ip-proxmox-host>
    # LAN address of the host. Used only by the netconsole role: netpoll writes
    # frames from the kernel, so the target cannot be a Tailscale address.
    proxmox_host_lan_ip: <lan-ip-proxmox>
    # Blackbox HTTPS probe targets (services behind `tailscale serve`).
    blackbox_https_targets:
      - { name: paperless,   url: "https://paperless.<tailnet-id>" }
      - { name: openwebui,   url: "https://ai-openwebui.<tailnet-id>" }
      - { name: nextcloud,   url: "https://nextcloud.<tailnet-id>" }
      - { name: calibreweb,  url: "https://calibreweb.<tailnet-id>" }
  children:
    media:
      hosts:
        vm100:  # Jellyfin, Audiobookshelf
          ansible_host: <tailscale-ip-gpu-vm>
        lxc220:  # Calibre-Web
          ansible_host: <tailscale-ip-calibreweb>

    ai_stack:
      hosts:
        vm100:  # Ollama backend
          ansible_host: <tailscale-ip-gpu-vm>
        lxc230:  # OpenWebUI
          ansible_host: <tailscale-ip-ai-openwebui>

    services:
      hosts:
        lxc210:  # Nextcloud
          ansible_host: <tailscale-ip-nextcloud>
        lxc211:  # Paperless-ngx
          ansible_host: <tailscale-ip-paperless>

    monitoring:
      hosts:
        lxc200:  # Prometheus + Grafana
          ansible_host: <tailscale-ip-monitoring>

    storage:
      hosts:
        vm102:  # SnapRAID + MergerFS
          ansible_host: <tailscale-ip-storage>

    database:
      hosts:
        lxc260:  # PostgreSQL platform
          ansible_host: <tailscale-ip-postgres>

    # The `security` group was removed together with lxc240 on 2026-09-01. It
    # had that one member and no playbook ever targeted it.
    # See docs/decisions/vaultwarden-decommission.md.

    docker:  # Nodes running Docker Compose stacks (Item #9 update workflow)
      hosts:
        lxc200:  # monitoring stack
          ansible_host: <tailscale-ip-monitoring>
        lxc211:  # paperless
          ansible_host: <tailscale-ip-paperless>
        lxc220:  # calibreweb
          ansible_host: <tailscale-ip-calibreweb>
        lxc230:  # openwebui
          ansible_host: <tailscale-ip-ai-openwebui>
        vm100:  # jellyfin + audiobookshelf
          ansible_host: <tailscale-ip-gpu-vm>

    lxcs:
      hosts:
        lxc200:
          ansible_host: <tailscale-ip-monitoring>
          prometheus_label: monitoring
        lxc210:
          ansible_host: <tailscale-ip-nextcloud>
          prometheus_label: nextcloud
        lxc211:
          ansible_host: <tailscale-ip-paperless>
          prometheus_label: paperless
        lxc220:
          ansible_host: <tailscale-ip-calibreweb>
          prometheus_label: calibreweb
        lxc230:
          ansible_host: <tailscale-ip-ai-openwebui>
          prometheus_label: openwebui
        # The control node, in the inventory since 2026-08-20. It was absent for
        # months, which meant `hosts: all` excluded it silently: no node_exporter
        # scrape, no NodeDown, no disk alert on its 8 GB root, and no patching.
        # It also holds the only copy of the vault password, the real inventory
        # and the Ansible SSH key, which made it the worst node on the fleet to
        # leave unmanaged.
        lxc250:
          ansible_host: <tailscale-ip-devops>
          prometheus_label: devops
        lxc260:
          ansible_host: <tailscale-ip-postgres>
          prometheus_label: postgres

    # Every node that is NOT the hypervisor. Sweeping playbooks target this
    # group, never `all`.
    #
    # That has gone wrong in both directions. `all` excluded lxc250 for months
    # because it belonged to no group, and nothing reported the absence. Since
    # the hypervisor joined the inventory on 2026-08-21 the same mechanism runs
    # the other way: a play written with `hosts: all` now also reaches the
    # machine that runs all ten guests. Naming the group in the playbook removes
    # the need to remember.
    #
    # Read-only playbooks may still use `all` - fleet-health-check.yml does, and
    # should, because the host belongs in a health report.
    guests:
      children:
        lxcs:
        vms:

    proxmox:
      hosts:
        proxmox-host:
          ansible_host: <tailscale-ip-proxmox-host>
          ansible_user: root  # No ansible user bootstrapped on hypervisor; use root directly

    vms:
      hosts:
        vm100:
          ansible_host: <tailscale-ip-gpu-vm>
          prometheus_label: gpu
        vm102:
          ansible_host: <tailscale-ip-storage>
          prometheus_label: storage

    # Nodes whose TLS-terminating service reads the Tailscale certificate straight
    # off disk instead of going through `tailscale serve`. They need the renewal +
    # reload timer, because renewing the file does not make the daemon re-read it
    # (KE-16). Serve-backed nodes must NOT be listed here.
    tailscale_cert_ondisk:
      hosts:
        lxc210:
