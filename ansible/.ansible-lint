# ansible-lint gate. CI pins the ansible-lint version (.github/workflows/ansible-lint.yml).
#
# Profile production, with one skip_list entry. Any other exception is an inline
# `# noqa: <rule>` on the task it concerns, with the reason in a comment beside it,
# so the rule stays armed everywhere else.
#
#   var-naming[no-role-prefix] - requires every role variable to carry the role
#   name as prefix (paperless_dbuser -> paperless_env_dbuser). The roles are not
#   published to Galaxy and their variables are already namespaced by purpose
#   (paperless_*, pg_backup_*), so the prefix adds length, not collision safety.
profile: production
skip_list:
  - var-naming[no-role-prefix]
