# {{ ansible_managed }}
[Unit]
Description=Full guest backup of every VM and LXC (vzdump)

# RequiresMountsFor= lets systemd derive the mount unit from the path, so no unit
# name is escaped by hand (a hyphen is `\x2d`; check with `systemd-escape -p`).
# An After= naming a nonexistent unit is silently no ordering.
#
# It also implies Requires=: if the mount cannot be activated, the job fails
# instead of writing to the wrong directory, and SystemdUnitFailed fires.
RequiresMountsFor={{ guest_backup_dir }}

[Service]
Type=oneshot
User=root
Group=root

# The run happens while the host is in use (it is off at night), so the backup
# yields to interactive work.
Nice={{ guest_backup_nice }}
IOSchedulingClass=idle
IOSchedulingPriority={{ guest_backup_ionice }}

ExecStart={{ guest_backup_script_dest }}

# No TimeoutStartSec (oneshot default: infinity). A timeout could kill a run
# mid-archive and leave a truncated file that the pruner keeps.
