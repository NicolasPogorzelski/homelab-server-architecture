#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Ports on this node that must not be reachable from off the node. Managed by the
# nft_guard role; see its defaults for why a filter rather than a bind address, and
# why this is never loaded through nftables.service.

# Idempotent prelude: declaring the table first lets the delete succeed on the
# first run too (deleting a missing table is an error), so `nft -f` is re-appliable.
table inet {{ nft_guard_table }}
delete table inet {{ nft_guard_table }}

table inet {{ nft_guard_table }} {
  chain input {
    type filter hook input priority filter; policy accept;

    # Loopback first: every consumer of the ports below is on this node (Nextcloud
    # reaches Collabora through proxy.php on its own web server).
    iifname "lo" accept

{% for entry in nft_guard_local_only_ports %}
    # {{ entry.reason }}
    tcp dport {{ entry.port }} counter drop

{% endfor %}
  }
}
