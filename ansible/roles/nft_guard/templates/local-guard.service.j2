# {{ ansible_managed }}
[Unit]
Description=Local port guard (nftables table {{ nft_guard_table }})
# Ordered after network-pre.target and tailscaled.service, so the table loads after
# tailscaled has started. It is not ordered before the interfaces come up.
After=network-pre.target tailscaled.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ nft_guard_rules_file }}
# Delete only this table on stop; `nft flush ruleset` would remove Tailscale's chains.
ExecStop=/usr/sbin/nft delete table inet {{ nft_guard_table }}

[Install]
WantedBy=multi-user.target
