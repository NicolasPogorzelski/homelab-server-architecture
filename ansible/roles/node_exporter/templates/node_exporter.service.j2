[Unit]
Description=Prometheus Node Exporter
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
User=node_exporter
{% set flags = ['--web.listen-address=' ~ ansible_host ~ ':' ~ node_exporter_port] %}
{% if node_exporter_textfile_dir %}
{% set _ = flags.append('--collector.textfile.directory=' ~ node_exporter_textfile_dir) %}
{% endif %}
{% if node_exporter_systemd_collector %}
{% set _ = flags.append('--collector.systemd') %}
{#
  systemd applies C-style escaping to ExecStart= arguments. `\.` is not one of the
  sequences it knows, so it passes the backslash through *and warns*
  ("Ignoring unknown escape sequences", visible via `systemd-analyze verify`).
  Relying on that is relying on an unspecified fallback. Doubling the backslash is
  the documented way to emit a literal one - see `ESCAPE SEQUENCES` in systemd.syntax(7).
  The variable itself stays a plain regex; the escaping belongs to this file.
#}
{% set _ = flags.append('--collector.systemd.unit-exclude=' ~ (node_exporter_systemd_unit_exclude | replace('\\', '\\\\'))) %}
{% endif %}
{% if node_exporter_tailscale_gate %}
{#
  Ordering after tailscaled is not readiness: systemd calls a unit started when
  its process is running, not when it is ready, so tailscaled counts as up while
  it is still negotiating and the address is still absent. This polls until the
  address is actually assigned to a local interface. It is fail-open - on timeout
  it warns and exits 0 - so the exporter starts late rather than not at all.
#}
ExecStartPre={{ node_exporter_wait_script }} {{ node_exporter_wait_timeout }}
{% endif %}
ExecStart=/usr/local/bin/node_exporter {{ flags | join(' ') }}
# Backstop for the case the gate times out and the bind still fails. Spaced at
# 15 s because systemd gives up after StartLimitBurst=5 starts inside
# StartLimitIntervalSec=10s, and at the stock 100 ms delay that limit trips in
# half a second - which is exactly how the hypervisor's exporter used to end up
# dead for the rest of the boot.
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
