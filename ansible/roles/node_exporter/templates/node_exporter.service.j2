[Unit]
Description=Prometheus Node Exporter
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
User={{ node_exporter_user }}
{% set flags = ['--web.listen-address=' ~ ansible_host ~ ':' ~ node_exporter_port] %}
{% if node_exporter_textfile_dir %}
{% set _ = flags.append('--collector.textfile.directory=' ~ node_exporter_textfile_dir) %}
{% endif %}
{% if node_exporter_systemd_collector %}
{% set _ = flags.append('--collector.systemd') %}
{#
  systemd applies C-style escaping to ExecStart= arguments and warns on the unknown
  `\.` ("Ignoring unknown escape sequences"). Doubling the backslash is the
  documented literal (ESCAPE SEQUENCES in systemd.syntax(7)). The variable stays a
  plain regex; the escaping belongs to this file.
#}
{% set _ = flags.append('--collector.systemd.unit-exclude=' ~ (node_exporter_systemd_unit_exclude | replace('\\', '\\\\'))) %}
{% endif %}
{% if node_exporter_tailscale_gate %}
{#
  Ordering after tailscaled is not readiness (KE-18): this polls until the address
  is assigned to a local interface. Fail-open - on timeout it warns and exits 0 -
  so the exporter starts late rather than not at all.
#}
ExecStartPre={{ node_exporter_wait_script }} {{ node_exporter_wait_timeout }}
{% endif %}
ExecStart=/usr/local/bin/node_exporter {{ flags | join(' ') }}
# Backstop for a gate timeout followed by a failed bind. 15 s, because at the stock
# 100 ms the start limit (5 starts in 10 s) trips in half a second and the unit
# stays dead for the rest of the boot.
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
