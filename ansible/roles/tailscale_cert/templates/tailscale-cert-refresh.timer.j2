# {{ ansible_managed }}
[Unit]
Description=Daily Tailscale TLS certificate refresh at {{ tailscale_cert_oncalendar }}

[Timer]
OnCalendar={{ tailscale_cert_oncalendar }}

# The host is powered down at this time (homelab_schedule). Persistent=true fires
# the overdue run at the next boot.
Persistent=true

Unit=tailscale-cert-refresh.service

[Install]
WantedBy=timers.target
