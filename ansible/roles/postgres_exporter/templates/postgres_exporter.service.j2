# {{ ansible_managed }}
[Unit]
Description=Prometheus PostgreSQL Exporter
After=network.target postgresql.service
# The exporter binds a Tailscale address, so tailscaled must have assigned it
# first - the KE-9/KE-12 boot-race class. postgresql_boot_order gates the database
# on the same condition.
Wants=tailscaled.service
After=tailscaled.service

[Service]
User={{ postgres_exporter_user }}
Group={{ postgres_exporter_group }}
EnvironmentFile={{ postgres_exporter_env_file }}
ExecStart={{ postgres_exporter_bin }} --web.listen-address={{ postgres_exporter_listen_address }}:{{ postgres_exporter_port }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
