# Managed by the tailscale_boot_gate Ansible role. Do not edit on the node.
#
# {{ item }} binds this node's Tailscale address, which does not exist at boot
# until tailscaled has configured the interface; bind() fails with EADDRNOTAVAIL.
# Ordering is not readiness (KE-18): the ExecStartPre polls until the address is
# assigned.
[Unit]
After=tailscaled.service
Wants=tailscaled.service

[Service]
ExecStartPre={{ tailscale_boot_gate_script }} {{ tailscale_boot_gate_timeout }}
# Backstop for a gate timeout (fail-open) followed by a failed bind. 15 s, because
# at the stock 100 ms the start limit (5 starts in 10 s) trips in half a second.
Restart=on-failure
RestartSec=15s
{% if tailscale_boot_gate_clear_restart_prevent %}
# Clears the packaged RestartPreventExitStatus list; Debian's ssh.service names 255,
# the code sshd exits with on a failed bind.
RestartPreventExitStatus=
{% endif %}
