// {{ ansible_managed }}
//
// Read after 20auto-upgrades and 50unattended-upgrades (lexical order in
// /etc/apt/apt.conf.d/), so the values here win. The `#clear` directives are
// load-bearing: APT appends to a list option when it is declared again, so
// without them this file would add the security origins to the stock list
// rather than replace it, and the regular archive would stay enabled.

APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";

#clear Unattended-Upgrade::Allowed-Origins;
{% if unattended_upgrades_allowed_origins %}
Unattended-Upgrade::Allowed-Origins {
{% for origin in unattended_upgrades_allowed_origins %}
    "{{ origin }}";
{% endfor %}
};
{% endif %}

#clear Unattended-Upgrade::Origins-Pattern;
{% if unattended_upgrades_origins_pattern %}
Unattended-Upgrade::Origins-Pattern {
{% for pattern in unattended_upgrades_origins_pattern %}
    "{{ pattern }}";
{% endfor %}
};
{% endif %}

#clear Unattended-Upgrade::Package-Blacklist;
Unattended-Upgrade::Package-Blacklist {
{% for pkg in unattended_upgrades_blacklist %}
    "{{ pkg }}";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "{{ unattended_upgrades_automatic_reboot | lower }}";
