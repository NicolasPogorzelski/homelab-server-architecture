# {{ ansible_managed }}
[Unit]
Description=Monthly PostgreSQL restore validation at {{ pg_restore_test_oncalendar }}

[Timer]
OnCalendar={{ pg_restore_test_oncalendar }}

# The host does not run on every calendar day (homelab_schedule). Persistent=true
# fires an overdue run at the next boot instead of skipping the month.
Persistent=true

# A catch-up lands in the boot window with every other Persistent=true job; the
# jitter keeps the restore from competing with the dump for the CIFS share.
RandomizedDelaySec=300

Unit=pg-restore-test.service

[Install]
WantedBy=timers.target
