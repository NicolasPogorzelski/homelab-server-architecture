# {{ ansible_managed }}
[Unit]
Description=Validate that the newest pg_dumpall backup can be restored
# Ordering only, no Wants=: the job does not touch the live cluster. Its real
# dependency, the CIFS backup share, is a Proxmox bind mount of a host automount;
# the script checks the mount's identity (findmnt must report cifs, see KE-15).
After=postgresql.service
# After= orders the two only when both jobs are queued together (for example both
# timers catching up at boot). Otherwise the script's -mmin guard skips a dump
# younger than five minutes, which may still be being written.
After=pg-backup.service

[Service]
Type=oneshot
# Runs as root, unlike pg-backup.service: pg_createcluster and pg_dropcluster write
# to /etc/postgresql and register cluster units. The script drops to postgres via
# runuser for every psql call.
WorkingDirectory=/tmp
ExecStart={{ pg_restore_test_script_dest }}
