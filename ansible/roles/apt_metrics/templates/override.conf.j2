# {{ ansible_managed }}
#
# Points the packaged collector at {{ apt_metrics_textfile_dir }}, the directory
# the fleet's node_exporter reads. ExecStart is cleared first; systemd would
# otherwise append and run the collector twice.
#
# `set -o pipefail` makes a failing collector fail the unit; without it the exit
# status is sponge's and a failed run leaves an empty file behind a success.
[Service]
ExecStart=
ExecStart=/bin/bash -c 'set -o pipefail; {{ apt_metrics_collector }} | sponge {{ apt_metrics_textfile_dir }}/apt.prom'
