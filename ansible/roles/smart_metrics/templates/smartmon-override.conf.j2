# {{ ansible_managed }}
[Service]
# TMPDIR and the output path both move into this host's textfile directory. The
# packaged unit points at Debian's, which node_exporter here does not read.
Environment=TMPDIR={{ smart_metrics_textfile_dir }}
# An empty assignment clears the packaged ExecStart before the replacement is
# added; otherwise systemd would run both.
ExecStart=
ExecStart=/bin/sh -o pipefail -c "{{ smart_metrics_collector }} | sponge {{ smart_metrics_textfile_dir }}/{{ smart_metrics_output }}"
# sponge creates the file under the unit's umask, which nothing here guarantees.
# node_exporter runs unprivileged and silently skips a file it cannot read.
ExecStartPost=/bin/chmod 0644 {{ smart_metrics_textfile_dir }}/{{ smart_metrics_output }}
