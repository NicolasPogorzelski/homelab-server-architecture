# {{ ansible_managed }}
#
# Reboot on an oops: this host has no out-of-band console. See the role defaults.

# Treat an oops as a panic rather than killing only the offending thread and
# carrying on with whatever locks it held.
kernel.panic_on_oops = {{ kernel_panic_on_oops }}

# Seconds between panic and reboot. 0 would wait forever; a short delay lets
# netconsole frames reach the receiver.
kernel.panic = {{ kernel_panic_timeout_seconds }}
