# {{ ansible_managed }}
[Unit]
Description=LAN ingress guard (nftables table {{ lan_guard_table }})
# After nftables.service, whose stock ruleset starts with `flush ruleset` and would
# delete this table if it loaded later. Before network.target, so nothing listens
# on the LAN before the filter is in place. No dependency on tailscaled: the table
# never touches tailscale0, and a guard that waited for Tailscale would leave the
# LAN open for exactly as long as Tailscale is broken.
DefaultDependencies=no
After=local-fs.target nftables.service
Before=network-pre.target network.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ lan_guard_rules_file }}
# Delete only this table on stop; `nft flush ruleset` would take Tailscale's and
# Docker's rules with it.
ExecStop=/usr/sbin/nft delete table inet {{ lan_guard_table }}

[Install]
WantedBy=multi-user.target
