# {{ ansible_managed }}
#
# EXERCISE - see docs/decisions/exercise-scope-before-terraform.md.

# Delete all rules first, so a reload does not stack on the previous set.
-D

# Kernel backlog; too small and events are dropped silently under load.
-b 8192

{% for rule in auditd_rules %}
{{ rule }}
{% endfor %}

{% if auditd_immutable %}
# Immutable until reboot; off by default, see the role defaults.
-e 2
{% endif %}
