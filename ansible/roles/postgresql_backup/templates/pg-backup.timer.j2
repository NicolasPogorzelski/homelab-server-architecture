# {{ ansible_managed }}
[Unit]
Description=Daily PostgreSQL backup at {{ pg_backup_oncalendar }}

[Timer]
OnCalendar={{ pg_backup_oncalendar }}

# The host is powered down at this time (homelab_schedule). Persistent=true records
# the last run under /var/lib/systemd/timers/ and fires an overdue job at boot.
Persistent=true

Unit=pg-backup.service

[Install]
WantedBy=timers.target
