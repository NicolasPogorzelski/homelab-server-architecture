# {{ ansible_managed }}
[Unit]
Description=Nightly SnapRAID sync at {{ snapraid_sync_oncalendar }}

[Timer]
OnCalendar={{ snapraid_sync_oncalendar }}
# The host may be off at the calendar time (homelab_schedule). Persistent=true runs
# the overdue sync at the next boot.
Persistent=true
Unit=snapraid-maintenance@sync.service

[Install]
WantedBy=timers.target
