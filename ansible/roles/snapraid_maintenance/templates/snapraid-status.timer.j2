# {{ ansible_managed }}
[Unit]
Description=SnapRAID coverage metrics at {{ snapraid_status_oncalendar }}

[Timer]
OnCalendar={{ snapraid_status_oncalendar }}
# Independent of the sync timer on purpose: a reading taken only by the job it
# describes cannot report that job failing or not running.
Persistent=true
Unit=snapraid-maintenance@status.service

[Install]
WantedBy=timers.target
