[Unit]
Description=Verify the storage permission matrix and publish the result
Documentation=file://{{ storage_permissions_conf }}
# The check walks the branches directly, but without the pool the branches may be
# unmounted too, and a check of absent directories would report a clean matrix.
Requires=mnt-mergerfs.mount
After=mnt-mergerfs.mount

[Service]
Type=oneshot
# --metrics exits 0 on drift, which StoragePermissionDrift reports. A non-zero exit
# means the check itself could not run, which SystemdUnitFailed reports.
ExecStart={{ storage_permissions_script_dest }} --metrics
Nice=10
IOSchedulingClass=idle
