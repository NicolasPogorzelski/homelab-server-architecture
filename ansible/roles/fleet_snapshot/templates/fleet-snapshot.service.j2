# {{ ansible_managed }}
[Unit]
Description=Record the fleet's unmanaged surface and diff it against last week
Documentation=file://{{ fleet_snapshot_repo }}/docs/platform/monitoring.md
# Every node is reached over Tailscale. Ordering is not readiness (KE-18), but a
# calendar timer starts this long after boot, so ordering suffices.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ fleet_snapshot_user }}
WorkingDirectory={{ fleet_snapshot_repo }}/ansible
Environment=PATH={{ fleet_snapshot_path }}
# ansible.cfg already points at ./inventory/hosts.yml and ~/.vault_pass; both
# exist only for this user on this node.
ExecStart={{ fleet_snapshot_playbook_bin }} {{ fleet_snapshot_playbook }}
# A run hanging on one unreachable node must not hold the timer open.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
