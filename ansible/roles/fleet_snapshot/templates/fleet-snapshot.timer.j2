# {{ ansible_managed }}
[Unit]
Description=Weekly fleet snapshot

[Timer]
OnCalendar={{ fleet_snapshot_on_calendar }}
# The host powers down nightly; Persistent=true runs a missed Saturday at the
# next boot instead of skipping the week.
Persistent=true
RandomizedDelaySec={{ fleet_snapshot_randomized_delay }}

[Install]
WantedBy=timers.target
