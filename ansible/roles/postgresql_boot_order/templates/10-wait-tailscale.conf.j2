# {{ ansible_managed }}
# Gate PostgreSQL startup on the Tailscale IP being present (KE-9). Started before
# tailscaled assigns it, the bind fails with EADDRNOTAVAIL and only loopback is
# served.
[Unit]
Wants=tailscaled.service
After=tailscaled.service

[Service]
ExecStartPre={{ pg_boot_order_wait_script }} {{ pg_boot_order_wait_timeout }}
