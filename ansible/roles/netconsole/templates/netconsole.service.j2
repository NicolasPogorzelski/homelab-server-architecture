{{ ansible_managed | comment }}
#
# Loads the netconsole module with a target from a unit instead of
# /etc/modules-load.d/: systemd-modules-load runs before the interface has an
# address, and netconsole would fail with only a journal line. Here it runs after
# network-online.target, and a failure is a failed unit (SystemdUnitFailed).
# See KE-18.

[Unit]
Description=Kernel log streaming to the Proxmox host (netconsole)
Documentation=https://www.kernel.org/doc/html/latest/networking/netconsole.html
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/sbin/modprobe netconsole netconsole={{ netconsole_src_port }}@{{ ansible_default_ipv4.address }}/{{ ansible_default_ipv4.interface }},{{ netconsole_target_port }}@{{ netconsole_target_ip }}/{{ netconsole_target_mac.stdout | trim }}
ExecStop=/sbin/modprobe -r netconsole

[Install]
WantedBy=multi-user.target
