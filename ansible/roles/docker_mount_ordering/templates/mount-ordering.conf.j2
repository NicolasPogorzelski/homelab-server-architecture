{{ ansible_managed | comment }}
#
# Wants= for the automount units: if a trigger fails, Docker still starts; an
# empty library is a smaller failure than a node without containers.
#
# RequiresMountsFor= for local paths: without Docker's data root the daemon would
# fill the root disk instead.

[Unit]
{% if docker_mount_ordering_units | length > 0 %}
Wants={{ docker_mount_ordering_units | join(' ') }}
After={{ docker_mount_ordering_units | join(' ') }}
{% endif %}
{% if docker_mount_ordering_required_paths | length > 0 %}
RequiresMountsFor={{ docker_mount_ordering_required_paths | join(' ') }}
{% endif %}
