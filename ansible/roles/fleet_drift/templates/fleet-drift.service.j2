# {{ ansible_managed }}
[Unit]
Description=Compare the repository against what the fleet actually runs
Documentation=file://{{ fleet_drift_repo }}/docs/platform/monitoring.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ fleet_drift_user }}
WorkingDirectory={{ fleet_drift_repo }}/ansible
# HOME is what makes ansible.cfg's `~/.vault_pass` and the SSH key resolve; both
# belong to this user and to no other account on the node.
Environment=HOME=/home/{{ fleet_drift_user }}
Environment=PATH={{ fleet_drift_path }}
Environment=FLEET_DRIFT_REPO={{ fleet_drift_repo }}
Environment=FLEET_DRIFT_REPORT_DIR={{ fleet_drift_report_dir }}
Environment=FLEET_DRIFT_MONITORING_HOST={{ fleet_drift_monitoring_host }}
Environment=FLEET_DRIFT_PROM_PORT={{ fleet_drift_prom_port }}
ExecStart={{ fleet_drift_script_dest }}
# The `+` prefix runs this one step with full privileges while the sweep itself
# stays unprivileged. node_exporter's collector directory is root-owned and the
# sweep's user cannot write to it; giving that directory away to make a shell
# script's life easier would weaken a path three other jobs already write into.
# Both paths sit under /var/lib, so the rename is atomic.
ExecStartPost=+/bin/mv {{ fleet_drift_report_dir }}/fleet-drift.prom {{ fleet_drift_textfile_dir }}/fleet-drift.prom
# Twenty-five playbooks across eleven nodes measured 4.3 minutes. The ceiling is
# generous because a single unreachable node stretches the run rather than
# failing it, and a sweep held open until next Sunday reports nothing at all.
TimeoutStartSec=2700

[Install]
WantedBy=multi-user.target
