# {{ ansible_managed }}
[Unit]
Description=Push this node's C1 datasets to the off-site restic repository
Documentation=file://{{ offsite_backup_repo_docs | default('/root/runbooks/backup/offsite-backup.md') }}
# The repository is reached over Tailscale. Ordering is not readiness (KE-18), but
# a unit started before tailscaled has no route at all.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ offsite_backup_env_file }}
ExecStart={{ offsite_backup_script_dest }}
# The first upload over a domestic uplink is slow; later runs are incremental. A
# generous ceiling, because a run cut off halfway is redone from the beginning.
TimeoutStartSec=21600
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
