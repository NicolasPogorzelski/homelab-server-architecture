# {{ ansible_managed }}
[Unit]
Description=Daily off-site backup

[Timer]
OnCalendar={{ offsite_backup_oncalendar }}
Persistent={{ offsite_backup_persistent | ternary('true', 'false') }}
# Two nodes write to the same server over one uplink. Without a spread they
# start in the same second and each halves the other's throughput.
RandomizedDelaySec={{ offsite_backup_randomized_delay }}

[Install]
WantedBy=timers.target
