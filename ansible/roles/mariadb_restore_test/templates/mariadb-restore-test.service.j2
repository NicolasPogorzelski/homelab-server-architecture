# {{ ansible_managed }}
[Unit]
Description=Validate that the newest MariaDB backup can be restored
# Ordering only, no Wants=: the test restores beside the live database and needs
# MariaDB up, but must not start it. If it is down, SystemdUnitFailed reports it.
After=mariadb.service
# When both timers catch up in the same boot window, let the dump finish first so
# the test does not pick a half-written file. The script's -mmin guard covers the
# case where they are not part of the same catch-up.
After=mariadb-backup.service

[Service]
Type=oneshot
# No User=, so root: like mariadb-backup.service, the client gets no credentials
# from the script and connects as the OS root user. The script creates and drops
# exactly one database and refuses to start if that name already exists.
WorkingDirectory=/tmp
ExecStart={{ mariadb_restore_test_script_dest }}
