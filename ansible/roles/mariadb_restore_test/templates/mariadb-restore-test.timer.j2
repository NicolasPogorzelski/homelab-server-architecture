# {{ ansible_managed }}
[Unit]
Description=Monthly MariaDB restore validation at {{ mariadb_restore_test_oncalendar }}

[Timer]
OnCalendar={{ mariadb_restore_test_oncalendar }}

# The host is not up every day; Persistent=true fires a missed monthly run at the
# next boot instead of skipping the month.
Persistent=true

# Catch-up runs share the boot window; jitter keeps the restore and the dump off
# the CIFS share at the same instant.
RandomizedDelaySec=300

Unit=mariadb-restore-test.service

[Install]
WantedBy=timers.target
