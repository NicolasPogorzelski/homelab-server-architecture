# Managed by the ssh_hardening Ansible role.
# sshd applies the first value it reads for a directive, and Include expands
# sshd_config.d/*.conf in sort order, so this 00- file wins over cloud-init's
# 50-cloud-init.conf without editing that regenerated file.
PasswordAuthentication {{ ssh_hardening_password_authentication }}
PermitRootLogin {{ ssh_hardening_permit_root_login }}
X11Forwarding {{ ssh_hardening_x11_forwarding }}
AllowTcpForwarding {{ ssh_hardening_allow_tcp_forwarding }}
MaxAuthTries {{ ssh_hardening_max_auth_tries }}
{% if ssh_hardening_listen_address | length > 0 %}
# ListenAddress replaces the wildcard bind; safe only with the boot gate the role
# asserts. See docs/decisions/sshd-listen-address.md.
ListenAddress {{ ssh_hardening_listen_address }}
{% endif %}
