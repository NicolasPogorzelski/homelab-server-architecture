# {{ ansible_managed }}
[Unit]
Description=Daily MariaDB backup at {{ mariadb_backup_oncalendar }}

[Timer]
OnCalendar={{ mariadb_backup_oncalendar }}

# The host is powered down at the scheduled hour (homelab_schedule).
# Persistent=true records the last run under /var/lib/systemd/timers/ and fires
# the overdue job at the next boot.
Persistent=true

# At boot this and pg-backup catch up together against the same CIFS server on
# vm102. The random delay spreads them without ordering one after the other.
RandomizedDelaySec={{ mariadb_backup_randomized_delay_sec }}

Unit=mariadb-backup.service

[Install]
WantedBy=timers.target
