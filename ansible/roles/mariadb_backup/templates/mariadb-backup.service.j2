# {{ ansible_managed }}
[Unit]
Description=MariaDB full backup (mariadb-dump to the CIFS share)
# The dump needs a running server. MariaDB binds loopback and does not wait for
# Tailscale, so the KE-9 readiness race does not apply.
After=mariadb.service
Wants=mariadb.service

[Service]
Type=oneshot
# Root: the script passes no credentials, so mariadb-dump connects over the local
# socket as the OS root user. No backup account password to store or rotate.
User=root
Group=root
ExecStart={{ mariadb_backup_script_dest }}
