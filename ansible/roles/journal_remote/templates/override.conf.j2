# {{ ansible_managed }}
#
# EXERCISE - see docs/decisions/exercise-scope-before-terraform.md.
#
# The unit runs with PrivateNetwork=yes and takes its listening socket from
# systemd as fd 3; the address is pinned in the socket drop-in. ExecStart is
# cleared first (systemd appends otherwise). HTTP, as the tailnet encrypts.
[Service]
ExecStart=
ExecStart=/lib/systemd/systemd-journal-remote --listen-http=-3 --output={{ journal_remote_dir }}/
