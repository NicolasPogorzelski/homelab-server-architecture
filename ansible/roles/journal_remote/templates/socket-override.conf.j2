# {{ ansible_managed }}
#
# EXERCISE - see docs/decisions/exercise-scope-before-terraform.md.
#
# The empty ListenStream= drops the packaged wildcard listener; the next line
# binds the Tailscale address only. FreeBind lets the socket bind before
# tailscaled has assigned the address.
[Socket]
ListenStream=
ListenStream={{ journal_remote_listen_address }}:{{ journal_remote_port }}
FreeBind=yes
