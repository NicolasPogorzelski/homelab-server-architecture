global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]
scrape_configs:
  # Prometheus self-scrape
  - job_name: "prometheus"
    static_configs:
      - targets: ["127.0.0.1:9090"]

  # Node Exporter - LXC200 monitoring (loopback, Docker container).
  # Resources only. A container cannot read the host's systemd, so this target
  # carries no `node_systemd_unit_state` and never could.
  - job_name: "node-lxc200-monitoring"
    static_configs:
      - targets: ["127.0.0.1:9100"]

  # Node Exporter - LXC200 native unit beside that container, systemd collector.
  # The second half of a deliberate duplication: one job for resources, one for
  # unit state, on the node that runs the alerting stack and was the last one
  # `SystemdUnitFailed` could not see.
  #
  # The port has no default here on purpose. It is a fact about the node and
  # lives in its host_vars; a default would let this file and the unit disagree
  # silently, and a target pointed at a port nothing listens on reports `up == 0`
  # as though the node were down.
  - job_name: "node-lxc200-monitoring-systemd"
    static_configs:
      - targets: ["{{ hostvars['lxc200']['ansible_host'] }}:{{ hostvars['lxc200']['node_exporter_port'] }}"]

  # PostgreSQL Exporter - CT260 (pg_stat_* metrics via Tailscale)
  - job_name: "postgres"
    static_configs:
      - targets: ["{{ hostvars['lxc260']['ansible_host'] }}:9187"]

  # Node Exporter - Proxmox hypervisor host (not in Ansible inventory - bare-metal host)
  - job_name: "node-proxmox-host"
    static_configs:
      - targets: ["{{ proxmox_host_tailscale_ip }}:9100"]

  # Node Exporter from inventory. lxc200 is written out above rather than swept
  # in here: it has two exporters, and this loop names a job after the node's
  # `prometheus_label`, so it would render the second one as a duplicate of
  # `node-lxc200-monitoring`. Prometheus refuses a config with two jobs of the
  # same name outright - the whole file fails to load, not just the duplicate.
  {% for host in groups['lxcs'] %}
  {% if host != 'lxc200' %}
  - job_name: "node-{{ host }}-{{ hostvars[host]['prometheus_label'] }}"
    static_configs:
      - targets: ["{{ hostvars[host]['ansible_host'] }}:9100"]
  {% endif %}
  {% endfor %}
  {% for host in groups['vms'] %}
  - job_name: "node-{{ host }}-{{ hostvars[host]['prometheus_label'] }}"
    static_configs:
      - targets: ["{{ hostvars[host]['ansible_host'] }}:9100"]
  {% endfor %}

  # Blackbox: service-level HTTP probes (KE-8 remediation).
  # Jellyfin + Audiobookshelf bind directly to a port on vm100.
  - job_name: "blackbox-http"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets: ["http://{{ hostvars['vm100']['ansible_host'] }}:8096"]
        labels:
          service: jellyfin
      - targets: ["http://{{ hostvars['vm100']['ansible_host'] }}:13378"]
        labels:
          service: audiobookshelf
    relabel_configs:
      # The probe target (URL) starts in __address__; move it to the module param.
      - source_labels: [__address__]
        target_label: __param_target
      # Keep the URL as the human-readable instance label.
      - source_labels: [__param_target]
        target_label: instance
      # Actually scrape the blackbox exporter, not the target itself.
      - target_label: __address__
        replacement: 127.0.0.1:9115

  # Blackbox: HTTPS services behind `tailscale serve` (MagicDNS targets from inventory).
  - job_name: "blackbox-https"
    metrics_path: /probe
    params:
      module: [http_service_up]
    static_configs:
    {% for t in blackbox_https_targets %}
      - targets: ["{{ t.url }}"]
        labels:
          service: "{{ t.name }}"
    {% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
