# =====================================================
# Secrets / Environment files (NEVER COMMIT)
# =====================================================

.env
.env.*
*.env
*.env.*

# The Ansible vault password lives in the control node's home, outside the tree.
# This keeps a copy that ever lands inside it out of git.
.vault_pass
**/.vault_pass

**/.env
**/.env.*
**/*.env
**/*.env.*

# allow env templates
!.env.example
!**/env.example
!**/*.env.j2

# =====================================================
# Databases / Runtime Data
# =====================================================

*.db
*.sqlite
*.sqlite3
*.sqlite3*
**/db.sqlite3*
**/data/
**/backup/
# `**/backup/` targets backup data directories; the runbook directory is re-included
# (git cannot re-include a file whose parent directory is excluded).
!runbooks/backup/

# =====================================================
# Private Keys / Certificates
# =====================================================

*.pem
*.key
*.crt
*.p12
*.pfx
**/rsa_key.pem

# =====================================================
# Logs / Temp / Cache
# =====================================================

*.log
*.tmp
*.temp
*.cache

# =====================================================
# Backups / Editor / OS junk
# =====================================================

*.bak
*.backup
*.old
*.orig
*.swp
*.save
*~
.DS_Store
Thumbs.db

# =====================================================
# Docker local overrides
# =====================================================

docker-compose.override.yml

# =====================================================
# Service configs with environment-specific values
# =====================================================

docker/monitoring/prometheus/prometheus.yml
docker/monitoring/grafana/provisioning/datasources/prometheus.yml
docker/monitoring/alertmanager/alertmanager.yml

# =====================================================
# Ansible - real inventory (contains Tailscale IPs)
# =====================================================

# Wider than the file on purpose, so backup copies such as hosts.yml.bak-* stay out
# too. The sanitized example is re-included.
ansible/inventory/hosts.yml*
!ansible/inventory/hosts.yml.example
# ansible-lint's cache, written when validate-repo.sh lints locally
ansible/.ansible/

# =====================================================
# AI coding assistant artifacts
# =====================================================

# aider
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# =====================================================
# Claude Code: CLAUDE.md, .claude/settings.json, two review agents and the start-scan
# skill are tracked; machine-specific settings, session files and patches stay local
# =====================================================
.claude/*
!.claude/settings.json
!.claude/agents/
.claude/agents/*
!.claude/agents/state-claims.md
!.claude/agents/prose-tics.md
!.claude/skills/
.claude/skills/*
!.claude/skills/start-scan/

# =====================================================
# Private sanitization legend (placeholders -> real values, NEVER COMMIT)
# =====================================================

SANITIZATION-LEGEND.local.md
*.local.md
