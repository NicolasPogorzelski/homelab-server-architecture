# Podman Quadlet for the primary inference backend on the admin workstation.
# Install: ~/.config/containers/systemd/llama-server.container, then
# `systemctl --user daemon-reload && systemctl --user start llama-server`.
# Autostart without login needs `loginctl enable-linger <user>`.
#
# Vulkan (RADV), not ROCm: the bundled ROCm runtime aborts on model load with this
# kernel and firmware, and Vulkan generates tokens faster on this card.
# Router mode: no model is resident after boot, so the GPU stays free until a
# request arrives; the model unloads again after 20 minutes idle.
# --image-min-tokens 1024: Qwen-VL projectors misread smaller images (llama.cpp
# warns at load). One slot is enough for one user.
# Both render nodes are passed because their numbering is not stable across boots;
# `-dev Vulkan0` selects the discrete card.

[Unit]
Description=llama.cpp inference server (Vulkan, discrete GPU)

[Container]
ContainerName=llama-server
Image=ghcr.io/ggml-org/llama.cpp:server-vulkan-b11243
AddDevice=/dev/dri/renderD128
AddDevice=/dev/dri/renderD129
Volume=%h/.local/share/models:/models:ro,Z
PublishPort=127.0.0.1:8080:8080
Secret=llama_api_key,type=env,target=LLAMA_API_KEY
Exec=--models-dir /models --models-max 1 -np 1 --image-min-tokens 1024 -dev Vulkan0 -c 65536 -ngl 99 -fa on -ctk q8_0 -ctv q8_0 --sleep-idle-seconds 1200 --host 0.0.0.0 --port 8080

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
