#!/usr/sbin/nft -f
#
# SMB boundary enforcement for VM102 (sanitized).
# Deployed to /etc/nftables.d/smb-guard.nft, loaded by snippets/systemd/smb-guard.service.
#
# Samba cannot bind an IPv4 address on tailscale0 (a point-to-point TUN without the
# BROADCAST flag), so `bind interfaces only = yes` would remove the Tailscale SMB path.
# smbd listens on the wildcard address, and the boundary is enforced here, in the kernel,
# before Samba accepts the connection (`hosts allow` acts only after the TCP accept).
#
# Own table and unit, never nftables.service or `flush ruleset`: the stock config and its
# ExecStop flush the whole ruleset, including Tailscale's ts-input / ts-forward chains.
# See docs/decisions/smb-bind-and-lan-access.md

# Idempotent prelude: declaring the table before deleting it makes `nft -f` re-appliable, and
# lets the delete succeed on the very first run too (deleting a non-existent table is an error).
table inet smb_guard
delete table inet smb_guard

table inet smb_guard {
  chain input {
    type filter hook input priority filter; policy accept;

    # Only the LAN interface is in scope; clients mounting over the Tailscale IP arrive on
    # tailscale0 and are unaffected by the rules below.
    iifname != "ens18" accept

    # The LAN interface carries a globally routable IPv6 address and smbd listens on [::]:445;
    # without this rule only the router's default inbound block keeps 445 unreachable.
    meta nfproto ipv6 tcp dport 445 counter drop

    # SMB over LAN IPv4: only the two nodes that mount shares (from `smbstatus -b`).
    # A rising drop counter means a consumer was missed.
    ip saddr { <lan-ip-vm100>, <lan-ip-proxmox> } tcp dport 445 counter accept
    tcp dport 445 counter drop
  }
}
