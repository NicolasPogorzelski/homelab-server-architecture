[Unit]
Description=Return blocks freed inside LXC containers to the LVM thin pool
Documentation=https://github.com/NicolasPogorzelski/homelab-server-architecture/blob/main/runbooks/platform/lvm-thin-pool-full.md
# pct fstrim enters each container's mount namespace, so the containers must be up.
After=pve-guests.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lxc-fstrim.sh

[Install]
WantedBy=multi-user.target
