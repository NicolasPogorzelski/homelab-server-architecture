[Unit]
Description=Daily LXC thin-pool reclaim
Documentation=https://github.com/NicolasPogorzelski/homelab-server-architecture/blob/main/runbooks/platform/lvm-thin-pool-full.md

[Timer]
# Wake times differ by weekday (`homelab_schedule` defaults), so no wall-clock time is
# inside the awake window every day; on days the host is still off, Persistent=true runs
# the overdue job after boot. Offset from the stock fstrim.timer.
OnCalendar=*-*-* 10:30:00

# The host is off at night; without catch-up a timer silently loses every missed run.
Persistent=true

RandomizedDelaySec=10m
AccuracySec=1m

[Install]
WantedBy=timers.target
