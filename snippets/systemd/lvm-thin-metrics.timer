[Unit]
Description=Sample LVM thin-pool utilisation every minute
Documentation=https://github.com/NicolasPogorzelski/homelab-server-architecture/blob/main/runbooks/platform/lvm-thin-pool-full.md

[Timer]
# Interval-based, not wall-clock: this samples a gauge, so it starts shortly after boot and
# runs steadily while the host is up.
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=5s

# No Persistent=true: catch-up is for jobs that must happen, not for sampling, where a
# missed sample is just a gap in the time series.
[Install]
WantedBy=timers.target
