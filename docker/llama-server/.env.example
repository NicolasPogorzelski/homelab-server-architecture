# llama-server environment (vm100)
# Copy to .env and fill in actual values:
#   cp .env.example .env
#   chmod 600 .env

# Bearer token OpenWebUI sends with every request.
# Generate with: openssl rand -hex 32
LLAMA_API_KEY=CHANGE_ME

# Loopback port that `tailscale serve --tcp` forwards to.
LLAMA_PORT=8080

# One subdirectory per model, holding the GGUF and its mmproj file. Lives on the
# auxiliary disk, never on the root disk.
LLAMA_MODELS_DIR=/path/to/models
