TZ=Europe/Berlin

PUID=1000
PGID=1000

JELLYFIN_PORT=8096
# vm100's Tailscale IPv4 address (`tailscale ip -4`). Jellyfin publishes on it
# directly; docker.service waits for it at boot through tailscale_boot_gate.
JELLYFIN_BIND_ADDR=<tailscale-ip-vm100>
# vm100's LAN IPv4 address. Only the streaming box reaches it: lan_guard admits
# its address alone on this port.
JELLYFIN_LAN_BIND_ADDR=<lan-ip-vm100>

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=video,compute,utility

JF_CONFIG=/path/to/config
JF_CACHE=/path/to/cache
JF_METADATA=/path/to/metadata

JF_MEDIA_FILME=/path/to/movies
JF_MEDIA_SERIEN=/path/to/shows
