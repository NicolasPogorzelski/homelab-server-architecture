global:
  resolve_timeout: 5m

route:
  receiver: discord
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
    # Watchdog fires permanently and goes only to the external heartbeat receiver;
    # its absence there means the alerting chain or the host is down. repeat_interval
    # must be shorter than the receiver's grace period, and that grace period longer
    # than the nightly power-down, or every morning starts with a false alarm.
    - receiver: heartbeat
      matchers:
        - alertname = "Watchdog"
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m

receivers:
  - name: discord
    discord_configs:
      - webhook_url: 'https://discord.com/api/webhooks/<id>/<token>'

  # Heartbeat services only register that the request arrived; the body is ignored.
  - name: heartbeat
    webhook_configs:
      - url: 'https://<heartbeat-provider>/ping/<token>'
        send_resolved: false

inhibit_rules:
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: ['alertname', 'instance']

  # Watchdog (severity: none) matches no inhibition. An inhibited heartbeat would
  # look like the outage it reports.
