#!/usr/bin/env bash
set -euo pipefail

# Tracked git hook, enabled once per clone with:
#
#   git config core.hooksPath scripts/hooks
#
# The file has no extension because git looks for exactly `commit-msg`. CI applies
# the same check in .github/workflows/commit-messages.yml.

exec "$(dirname "$0")/../commit-msg-lint.sh" "$@"
