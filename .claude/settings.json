{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre-commit-guard.sh",
            "timeout": 60,
            "statusMessage": "Validating repository before commit"
          }
        ]
      }
    ]
  }
}
